use "game".

Note: ===================== MOD ZONE =====================
let TRACK_LENGTH be a standard number with value 30.
let PLAYER_NAME be a text with value "You".
let CPU1_NAME be a text with value "Bowser".
let CPU2_NAME be a text with value "Peach".
let CPU3_NAME be a text with value "Toad".
let ITEM_CHANCE be a standard number with value 40.
Note: ====================================================

Note: Item codes: 0 = none, 1 = Mushroom, 2 = Banana, 3 = Blue Shell.

To kartName with a standard number idx and a text p and a text c1 and a text c2 and a text c3 returning a text:
    If idx is equal to 0 then
        Give back p.
    End.
    If idx is equal to 1 then
        Give back c1.
    End.
    If idx is equal to 2 then
        Give back c2.
    End.
    Give back c3.
End.

To itemName with a standard number code returning a text:
    If code is equal to 1 then
        Give back "Mushroom".
    End.
    If code is equal to 2 then
        Give back "Banana".
    End.
    If code is equal to 3 then
        Give back "Blue Shell".
    End.
    Give back "nothing".
End.

Note: ----- Race state: index 0 is you, 1-3 are the CPUs -----
let positions be a list of standard number with value [0, 0, 0, 0].
let playerItem be a standard number with value 0.
let racing be a standard number with value 1.
let winner be a standard number with value negative 1.

output "=== KART RACE ===".
output the result of combine with "First kart to reach the finish line wins. Track length: " and the result of numberToText with TRACK_LENGTH.
output "Each turn: type 'gas' to drive, 'item' to use your item, or 'quit'.".

While racing is equal to 1,
    Note: ----- Show the standings -----
    Call printBorder with TRACK_LENGTH + 3.
    let k be a standard number with value 0.
    While k is at most 3,
        let shown be a standard number with value positions[k].
        If shown is greater than TRACK_LENGTH then
            Set shown to TRACK_LENGTH.
        End.
        let gap be a standard number with value TRACK_LENGTH.
        Subtract shown from gap.
        let lane be a text with value the result of repeatText with "-" and shown.
        Set lane to the result of combine with lane and ">".
        let dots be a text with value the result of repeatText with "." and gap.
        Set lane to the result of combine with lane and dots.
        let name be a text with value the result of kartName with k and PLAYER_NAME and CPU1_NAME and CPU2_NAME and CPU3_NAME.
        Call printRow with lane.
        output the result of combine with "  ^ " and name.
        Add 1 to k.
    End.
    Call printBorder with TRACK_LENGTH + 3.
    output the result of combine with "Your item: " and the result of itemName with playerItem.
    output "Your move:".
    let command be a text with value the result of readLine.

    If command is equal to "quit" then
        Set racing to 0.
    otherwise if command is equal to "gas" then
        let roll be a standard number with value the result of randomBetween with 1 and 3.
        Set positions[0] to positions[0] + roll.
        If playerItem is equal to 0 then
            let lucky be a standard number with value the result of randomBetween with 1 and 100.
            If lucky is at most ITEM_CHANCE then
                Set playerItem to the result of randomBetween with 1 and 3.
                let gotName be a text with value the result of itemName with playerItem.
                let pickupMsg be a text with value the result of combine with "You picked up a " and gotName.
                Set pickupMsg to the result of combine with pickupMsg and "!".
                output pickupMsg.
            End.
        End.
    otherwise if command is equal to "item" then
        If playerItem is equal to 1 then
            Set positions[0] to positions[0] + 3.
            output "Mushroom boost! You zoom ahead 3 spaces.".
            Set playerItem to 0.
        otherwise if playerItem is equal to 2 then
            Set positions[1] to positions[1] - 2.
            If positions[1] is less than 0 then
                Set positions[1] to 0.
            End.
            output the result of combine with "You drop a banana! " and the result of combine with CPU1_NAME and " slips back 2 spaces.".
            Set playerItem to 0.
        otherwise if playerItem is equal to 3 then
            Note: STUDENT GAP: make the Blue Shell strike the kart in the lead!
            output "The Blue Shell fizzles... (Students: code it to hit the leader!)".
            Set playerItem to 0.
        otherwise
            output "You don't have an item yet. Type 'gas' to race for one.".
        End.
    otherwise
        output "Unknown move. Try 'gas', 'item', or 'quit'.".
    End.

    Note: ----- CPUs take their turn -----
    If racing is equal to 1 then
        let cpu be a standard number with value 1.
        While cpu is at most 3,
            let cpuRoll be a standard number with value the result of randomBetween with 1 and 3.
            Set positions[cpu] to positions[cpu] + cpuRoll.
            Add 1 to cpu.
        End.
    End.

    Note: ----- Did anyone cross the finish line? -----
    let racer be a standard number with value 0.
    While racer is at most 3,
        If positions[racer] is at least TRACK_LENGTH then
            If winner is equal to negative 1 then
                Set winner to racer.
            End.
        End.
        Add 1 to racer.
    End.
    If winner is greater than negative 1 then
        Set racing to 0.
    End.
End.

If winner is greater than negative 1 then
    let championName be a text with value the result of kartName with winner and PLAYER_NAME and CPU1_NAME and CPU2_NAME and CPU3_NAME.
    output the result of combine with "WINNER: " and championName.
otherwise
    output "Race abandoned. See you next time!".
End.
